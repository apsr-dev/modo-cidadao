{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": [
      "**",
      "!!.tools",
      "!!node_modules",
      "!!**/dist",
      "!!**/routeTree.gen.ts",
      "!!supabase/.temp",
      "!!supabase/.branches",
      "!!playwright-report",
      "!!test-results",
      "!!bun.lock",
      "!!**/node_modules",
      "!!**/.turbo",
      "!!**/.git"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error",
        "noUndeclaredEnvVars": "off"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
