# Copy to .env in the repository root. Never commit .env.
# Explicit demonstration without database or simulated authentication.
DEMO_MODE=true
VITE_APP_NAME=Plataforma Cívica
VITE_APP_URL=http://localhost:3000
# Private server environment. Public Supabase key may be shared; never use a secret key here.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-or-anon-key
# PostgreSQL roles: web reads civic; worker writes civic/internal. prepare:false; small pools.
DATABASE_READ_URL=postgresql://civica_reader:replace-local-password@127.0.0.1:54322/postgres
DATABASE_URL=postgresql://civica_ingest:replace-local-password@127.0.0.1:54322/postgres
# Only local administration / integration tests. Never used by the web.
MIGRATION_DATABASE_URL=postgresql://postgres:replace-local-admin-password@127.0.0.1:54322/postgres
# Used only by opt-in local integration tests to create/delete two temporary test accounts.
SUPABASE_SECRET_KEY=replace-with-local-secret-or-service-role-key
PORT=3000
