{
  "openapi": "3.1.0",
  "info": {
    "title": "Plataforma cívica — contrato local",
    "version": "1.1.0",
    "description": "Endpoints implementados na fundação. Demo e integração local têm cobertura explicitada. Não é compromisso de abertura pública em produção."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Ambiente local"
    }
  ],
  "paths": {
    "/api/v1/representatives": {
      "get": {
        "operationId": "listRepresentatives",
        "parameters": [
          {
            "name": "name",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 100,
              "default": ""
            }
          },
          {
            "name": "uf",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "AC",
                "AL",
                "AP",
                "AM",
                "BA",
                "CE",
                "DF",
                "ES",
                "GO",
                "MA",
                "MT",
                "MS",
                "MG",
                "PA",
                "PB",
                "PR",
                "PE",
                "PI",
                "RJ",
                "RN",
                "RS",
                "RO",
                "RR",
                "SC",
                "SP",
                "SE",
                "TO"
              ]
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000,
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 6
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RepresentativesPage"
                }
              }
            }
          },
          "400": {
            "description": "Entrada inválida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Serviço indisponível",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/people/{id}": {
      "get": {
        "operationId": "getPerson",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Representative"
                }
              }
            }
          },
          "400": {
            "description": "Entrada inválida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Pessoa inexistente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Serviço indisponível",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/me/follows": {
      "get": {
        "operationId": "listMyFollows",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Follows"
                }
              }
            }
          },
          "401": {
            "description": "Sessão/token inválido ou ausente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Serviço indisponível",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/me/follows/people/{id}": {
      "put": {
        "operationId": "followPerson",
        "description": "Aceita JWT Bearer. Cookies SSR da web também são aceitos; nesse caso Origin deve coincidir com VITE_APP_URL. Identidade sempre verificada pelo servidor.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MutationResult"
                }
              }
            }
          },
          "400": {
            "description": "Entrada inválida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Sessão/token inválido ou ausente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Origin não permitido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Serviço indisponível",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Pessoa inexistente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "unfollowPerson",
        "description": "Aceita JWT Bearer. Cookies SSR da web também são aceitos; nesse caso Origin deve coincidir com VITE_APP_URL. Identidade sempre verificada pelo servidor.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MutationResult"
                }
              }
            }
          },
          "400": {
            "description": "Entrada inválida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Sessão/token inválido ou ausente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Origin não permitido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Serviço indisponível",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/proposals": {
      "get": {
        "operationId": "listProposals",
        "parameters": [
          {
            "name": "type",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9]{0,9}$"
            }
          },
          {
            "name": "number",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            }
          },
          {
            "name": "year",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1900,
              "maximum": 2100
            }
          },
          {
            "name": "authorId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000,
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 6
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProposalsPage"
                }
              }
            }
          },
          "400": {
            "description": "Entrada inválida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Serviço indisponível",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "description": "Consulta somente o catálogo local importado, ordenado por ano/número decrescentes e ID. Cobertura parcial. Tipo é normalizado para maiúsculas."
      }
    },
    "/api/v1/proposals/{id}": {
      "get": {
        "operationId": "getProposal",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Proposal"
                }
              }
            }
          },
          "400": {
            "description": "Entrada inválida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Proposta não importada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Serviço indisponível",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "DataValue": {
        "oneOf": [
          {
            "type": "object",
            "required": ["state", "value"],
            "properties": {
              "state": {
                "const": "available"
              },
              "value": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "required": ["state", "value"],
            "properties": {
              "state": {
                "enum": ["not_informed", "not_collected", "not_applicable"]
              },
              "value": {
                "type": "null"
              }
            }
          }
        ]
      },
      "Representative": {
        "type": "object",
        "required": [
          "id",
          "name",
          "civilName",
          "uf",
          "legislature",
          "institution",
          "party",
          "status",
          "email",
          "phone",
          "demo",
          "provenance"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "civilName": {
            "$ref": "#/components/schemas/DataValue"
          },
          "uf": {
            "type": "string",
            "enum": [
              "AC",
              "AL",
              "AP",
              "AM",
              "BA",
              "CE",
              "DF",
              "ES",
              "GO",
              "MA",
              "MT",
              "MS",
              "MG",
              "PA",
              "PB",
              "PR",
              "PE",
              "PI",
              "RJ",
              "RN",
              "RS",
              "RO",
              "RR",
              "SC",
              "SP",
              "SE",
              "TO"
            ]
          },
          "legislature": {
            "type": "string"
          },
          "institution": {
            "const": "camara"
          },
          "party": {
            "$ref": "#/components/schemas/DataValue"
          },
          "status": {
            "$ref": "#/components/schemas/DataValue"
          },
          "email": {
            "$ref": "#/components/schemas/DataValue"
          },
          "phone": {
            "$ref": "#/components/schemas/DataValue"
          },
          "demo": {
            "type": "boolean"
          },
          "provenance": {
            "type": "object",
            "required": [
              "source",
              "externalId",
              "officialUrl",
              "resourceUrl",
              "fetchedAt",
              "normalizerVersion"
            ],
            "properties": {
              "source": {
                "enum": ["camara", "demo"]
              },
              "externalId": {
                "type": "string"
              },
              "officialUrl": {
                "type": ["string", "null"],
                "format": "uri"
              },
              "resourceUrl": {
                "type": ["string", "null"],
                "format": "uri"
              },
              "fetchedAt": {
                "type": "string",
                "format": "date-time"
              },
              "normalizerVersion": {
                "type": "string"
              }
            }
          }
        }
      },
      "RepresentativesPage": {
        "type": "object",
        "required": ["items", "total", "page", "pageSize", "pages"],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Representative"
            }
          },
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "pageSize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          },
          "pages": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message", "requestId"],
            "properties": {
              "code": {
                "enum": ["INVALID_INPUT", "UNAUTHORIZED", "FORBIDDEN", "NOT_FOUND", "UNAVAILABLE"]
              },
              "message": {
                "type": "string"
              },
              "requestId": {
                "type": "string",
                "format": "uuid"
              }
            }
          }
        }
      },
      "Follows": {
        "type": "object",
        "required": ["ids"],
        "properties": {
          "ids": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      },
      "MutationResult": {
        "type": "object",
        "required": ["ok"],
        "properties": {
          "ok": {
            "const": true
          }
        }
      },
      "Provenance": {
        "type": "object",
        "required": [
          "source",
          "externalId",
          "officialUrl",
          "resourceUrl",
          "fetchedAt",
          "normalizerVersion"
        ],
        "properties": {
          "source": {
            "enum": ["camara", "demo"]
          },
          "externalId": {
            "type": "string"
          },
          "officialUrl": {
            "type": ["string", "null"],
            "format": "uri"
          },
          "resourceUrl": {
            "type": ["string", "null"],
            "format": "uri"
          },
          "fetchedAt": {
            "type": "string",
            "format": "date-time"
          },
          "normalizerVersion": {
            "type": "string"
          }
        }
      },
      "ProposalAuthor": {
        "type": "object",
        "required": [
          "id",
          "name",
          "type",
          "sourceUrl",
          "deputyExternalId",
          "personId",
          "signatureOrder",
          "proponent"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "$ref": "#/components/schemas/DataValue"
          },
          "sourceUrl": {
            "type": ["string", "null"],
            "format": "uri"
          },
          "deputyExternalId": {
            "type": ["string", "null"]
          },
          "personId": {
            "type": ["string", "null"],
            "format": "uuid"
          },
          "signatureOrder": {
            "type": ["integer", "null"],
            "minimum": 0
          },
          "proponent": {
            "type": ["boolean", "null"],
            "description": "true: proponente; false: signatário de apoio; null: não informado"
          }
        }
      },
      "ProposalEvent": {
        "type": "object",
        "required": [
          "sequence",
          "occurredAt",
          "organ",
          "description",
          "situation",
          "dispatch",
          "documentUrl"
        ],
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 0
          },
          "occurredAt": {
            "type": "string",
            "description": "Timestamp original da fonte; pode não incluir fuso. Não presumir UTC."
          },
          "organ": {
            "$ref": "#/components/schemas/DataValue"
          },
          "description": {
            "$ref": "#/components/schemas/DataValue"
          },
          "situation": {
            "$ref": "#/components/schemas/DataValue"
          },
          "dispatch": {
            "$ref": "#/components/schemas/DataValue"
          },
          "documentUrl": {
            "type": ["string", "null"],
            "format": "uri"
          }
        }
      },
      "ProposalSummary": {
        "type": "object",
        "required": [
          "id",
          "type",
          "number",
          "year",
          "title",
          "descriptionType",
          "presentedAt",
          "situation",
          "organ",
          "fullTextUrl",
          "authors",
          "demo",
          "provenance"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "type": "string"
          },
          "number": {
            "type": "integer",
            "minimum": 1
          },
          "year": {
            "type": "integer",
            "minimum": 1900,
            "maximum": 2100
          },
          "title": {
            "type": "string"
          },
          "descriptionType": {
            "$ref": "#/components/schemas/DataValue"
          },
          "presentedAt": {
            "$ref": "#/components/schemas/DataValue"
          },
          "situation": {
            "$ref": "#/components/schemas/DataValue"
          },
          "organ": {
            "$ref": "#/components/schemas/DataValue"
          },
          "fullTextUrl": {
            "type": ["string", "null"],
            "format": "uri"
          },
          "authors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProposalAuthor"
            }
          },
          "demo": {
            "type": "boolean"
          },
          "provenance": {
            "$ref": "#/components/schemas/Provenance"
          }
        }
      },
      "Proposal": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ProposalSummary"
          },
          {
            "type": "object",
            "required": ["events", "authorsCollectedAt", "eventsCollectedAt"],
            "properties": {
              "events": {
                "type": "array",
                "maxItems": 1000,
                "items": {
                  "$ref": "#/components/schemas/ProposalEvent"
                }
              },
              "authorsCollectedAt": {
                "type": "string",
                "format": "date-time"
              },
              "eventsCollectedAt": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        ]
      },
      "ProposalsPage": {
        "type": "object",
        "required": ["items", "total", "page", "pageSize", "pages"],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProposalSummary"
            }
          },
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "pageSize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          },
          "pages": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
